# ---------------------------------------------------------------------------
# ByMaster — ortam değişkenleri
# Bu dosyayı .env olarak kopyalayın ve değerleri doldurun.
# Gizli anahtarlar yalnızca sunucuda okunur; NEXT_PUBLIC_ önekiyle ASLA paylaşılmaz.
# ---------------------------------------------------------------------------

# Veritabanı (yerel geliştirme: SQLite). Üretim için PostgreSQL önerilir (README'ye bakın).
DATABASE_URL="file:./dev.db"

# Sitenin herkese açık adresi (canonical URL, sitemap, ödeme geri dönüş adresleri)
APP_URL="http://localhost:3000"

# En az 32 karakter rastgele değer: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

# Yüklenen görsellerin saklanacağı klasör (public dışında)
UPLOAD_DIR="./storage/uploads"

# ---------------------------------------------------------------------------
# Ödeme
# PAYMENT_PROVIDER: none | paytr | iyzico | mock
#   mock yalnızca PAYMENT_MODE=test iken çalışan yerel simülatördür; gerçek tahsilat yapmaz.
# PAYMENT_MODE: test | live  (test modunda sitede kalıcı "TEST MODU" uyarısı gösterilir)
# ---------------------------------------------------------------------------
PAYMENT_PROVIDER="none"
PAYMENT_MODE="test"

# PayTR (iFrame API) — Mağaza Paneli > Bilgi sayfasından alınır
PAYTR_MERCHANT_ID=""
PAYTR_MERCHANT_KEY=""
PAYTR_MERCHANT_SALT=""

# iyzico (Checkout Form) — test: https://sandbox-api.iyzipay.com  canlı: https://api.iyzipay.com
IYZICO_API_KEY=""
IYZICO_SECRET_KEY=""
IYZICO_BASE_URL="https://sandbox-api.iyzipay.com"
# iyzico alıcı için TCKN zorunlu tutar; TCKN toplanmıyorsa iyzico'nun kabul ettiği varsayılan değer kullanılır
IYZICO_DEFAULT_IDENTITY_NUMBER="11111111111"

# ---------------------------------------------------------------------------
# E-posta (SMTP). Boş bırakılırsa e-postalar gönderilmez, yalnızca kayıt altına alınır.
# ---------------------------------------------------------------------------
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="ByMaster <siparis@ornek-alanadi.com>"

# Arama motorlarının siteyi dizinlemesini engellemek için (ör. test sunucusu): true
NOINDEX="false"

# Zamanlanmış görev anahtarı (isteğe bağlı). Tanımlanırsa ödeme süresi dolan siparişler
#   curl -X POST -H "Authorization: Bearer <CRON_SECRET>" https://alanadiniz.com/api/cron/siparis-suresi
# çağrısıyla kapatılıp stokları serbest bırakılır (ör. 5 dakikada bir). Boşsa uç nokta kapalıdır.
# Üretmek için: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=""
