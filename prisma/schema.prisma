// ByMaster veri modeli
// - Para tutarları kuruş cinsinden tamsayı (Int) olarak saklanır; ondalık hata riski yoktur.
// - Durum alanları PostgreSQL'e taşınabilirlik için metin olarak tutulur; izin verilen
//   değerler src/lib/constants.ts içinde tanımlanır ve sunucu tarafında zod ile doğrulanır.
// - Üretimde PostgreSQL için yalnızca `provider` değerini değiştirip yeni migration üretmeniz yeterlidir.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Hesaplar ve oturumlar
// ---------------------------------------------------------------------------

model User {
  id                 String    @id @default(cuid())
  email              String    @unique // her zaman küçük harfe normalize edilir
  passwordHash       String
  name               String
  phone              String?
  role               String    @default("CUSTOMER") // CUSTOMER | ADMIN
  accountType        String    @default("INDIVIDUAL") // INDIVIDUAL | BUSINESS
  companyName        String?
  taxOffice          String?
  taxNumber          String?
  marketingConsent   Boolean   @default(false)
  marketingConsentAt DateTime?
  isActive           Boolean   @default(true)
  priceListId        String?
  lastLoginAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  priceList      PriceList?           @relation(fields: [priceListId], references: [id], onDelete: SetNull)
  sessions       Session[]
  resetTokens    PasswordResetToken[]
  addresses      Address[]
  orders         Order[]
  cart           Cart?
  quoteRequests  QuoteRequest[]
  returnRequests ReturnRequest[]
  auditLogs      AuditLog[]

  @@index([role])
  @@index([priceListId])
}

model Session {
  id         String   @id // SHA-256(token); ham token yalnızca httpOnly çerezde bulunur
  userId     String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  userAgent  String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id // SHA-256(token)
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Address {
  id          String   @id @default(cuid())
  userId      String
  title       String
  fullName    String
  phone       String
  city        String
  district    String
  addressLine String
  postalCode  String?
  isDefault   Boolean  @default(false)
  invoiceType String   @default("INDIVIDUAL") // INDIVIDUAL | CORPORATE
  companyName String?
  taxOffice   String?
  taxNumber   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Katalog
// ---------------------------------------------------------------------------

model Category {
  id             String   @id @default(cuid())
  slug           String   @unique
  name           String
  shortName      String?
  description    String?
  menuGroup      String? // Mega menü sütunu (ör. "Soslar")
  imageUrl       String?
  imageAlt       String?
  accentColor    String?
  sortOrder      Int      @default(0)
  isActive       Boolean  @default(true)
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  primaryProducts Product[]         @relation("PrimaryCategory")
  products        ProductCategory[]

  @@index([isActive, sortOrder])
}

model Product {
  id                String    @id @default(cuid())
  slug              String    @unique
  name              String
  subtitle          String?
  brand             String?
  kind              String    @default("SIMPLE") // SIMPLE | KIT
  status            String    @default("DRAFT") // DRAFT | ACTIVE | ARCHIVED
  saleStatus        String    @default("AVAILABLE") // AVAILABLE | COMING_SOON
  primaryCategoryId String
  shortDescription  String?
  description       String?
  // Gıda bilgileri: boş bırakılırsa vitrinde "henüz eklenmedi" olarak gösterilir, asla tahmin edilmez.
  ingredients       String?
  allergens         String?
  mayContain        String?
  storageConditions String?
  shelfLife         String?
  usageAreasText    String?
  usageTips         String?
  kitContents       String? // satır başına bir kalem
  kitPreparation    String? // satır başına bir adım
  servingInfo       String?
  originInfo        String?
  accentColor       String?
  isFeatured        Boolean   @default(false)
  freeShipping      Boolean   @default(false)
  sortOrder         Int       @default(0)
  seoTitle          String?
  seoDescription    String?
  searchText        String    @default("") // Türkçe karakterleri sadeleştirilmiş arama metni
  publishedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  primaryCategory Category          @relation("PrimaryCategory", fields: [primaryCategoryId], references: [id], onDelete: Restrict)
  categories      ProductCategory[]
  variants        ProductVariant[]
  images          ProductImage[]
  tags            ProductTag[]
  relations       ProductRelation[] @relation("RelationSource")
  relatedTo       ProductRelation[] @relation("RelationTarget")
  blogPosts       BlogPostProduct[]
  orderItems      OrderItem[]

  @@index([status, saleStatus])
  @@index([primaryCategoryId])
  @@index([isFeatured])
}

// Birincil kategori de her zaman bu tabloda yer alır (listeleme sorgularını sadeleştirir).
model ProductCategory {
  productId  String
  categoryId String
  sortOrder  Int    @default(0)

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@index([categoryId])
}

model ProductVariant {
  id                  String   @id @default(cuid())
  productId           String
  sku                 String   @unique
  name                String // ör. "10 kg Kova"
  packageType         String // KOVA | PAKET | KUTU | SISE | KOLI
  netWeightGrams      Int?
  unitsPerCase        Int? // koli içi adet
  priceKurus          Int // KDV dahil satış fiyatı
  compareAtPriceKurus Int? // yalnızca gerçek bir indirimde önceki fiyat
  vatRate             Int      @default(1)
  trackStock          Boolean  @default(true)
  stock               Int      @default(0)
  lowStockThreshold   Int      @default(5)
  minOrderQty         Int      @default(1)
  maxOrderQty         Int?
  servingGrams        Int? // doğrulanmış porsiyon başı kullanım miktarı (g) — porsiyon hesaplayıcı
  isDefault           Boolean  @default(false)
  isActive            Boolean  @default(true)
  sortOrder           Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  product            Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems          CartItem[]
  orderItems         OrderItem[]
  movements          InventoryMovement[]
  stockNotifications StockNotification[]
  priceListEntries   PriceListEntry[]
  quoteItems         QuoteRequestItem[]

  @@index([productId])
}

model ProductImage {
  id            String   @id @default(cuid())
  productId     String
  url           String
  alt           String
  width         Int?
  height        Int?
  kind          String   @default("PACKSHOT") // PACKSHOT | DETAIL | LIFESTYLE
  isPlaceholder Boolean  @default(false) // "Temsili görsel" etiketi gösterilir
  fit           String   @default("contain") // contain: beyaz zemin, sığdır | cover: kadraja dayalı, doldur
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
}

model Tag {
  id          String   @id @default(cuid())
  type        String // FLAVOR | USAGE
  slug        String
  name        String
  description String?
  color       String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  products ProductTag[]

  @@unique([type, slug])
}

model ProductTag {
  productId String
  tagId     String

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([productId, tagId])
  @@index([tagId])
}

// Yönetici tarafından belirlenen "Birlikte iyi gider" eşleşmeleri
model ProductRelation {
  sourceId  String
  targetId  String
  type      String @default("PAIRS_WITH")
  sortOrder Int    @default(0)

  source Product @relation("RelationSource", fields: [sourceId], references: [id], onDelete: Cascade)
  target Product @relation("RelationTarget", fields: [targetId], references: [id], onDelete: Cascade)

  @@id([sourceId, targetId, type])
  @@index([targetId])
}

// Her stok değişikliği bu tabloya yazılır (izlenebilirlik)
model InventoryMovement {
  id         String   @id @default(cuid())
  variantId  String
  change     Int
  stockAfter Int
  reason     String // ADJUSTMENT | RESTOCK | ORDER_RESERVED | ORDER_RELEASED | RETURN | CORRECTION
  orderId    String?
  note       String?
  actorId    String?
  createdAt  DateTime @default(now())

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([variantId, createdAt])
  @@index([orderId])
}

model StockNotification {
  id         String    @id @default(cuid())
  variantId  String
  email      String
  createdAt  DateTime  @default(now())
  notifiedAt DateTime?

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([variantId, email])
  @@index([notifiedAt])
}

// ---------------------------------------------------------------------------
// Sepet
// ---------------------------------------------------------------------------

model Cart {
  id         String   @id @default(cuid())
  tokenHash  String?  @unique // misafir sepeti: SHA-256(çerez token'ı)
  userId     String?  @unique
  couponCode String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user  User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@index([updatedAt])
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  variantId String
  quantity  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([cartId, variantId])
}

// ---------------------------------------------------------------------------
// Siparişler ve ödemeler
// ---------------------------------------------------------------------------

model Order {
  id                   String    @id @default(cuid())
  orderNumber          String    @unique
  userId               String?
  status               String // PENDING_PAYMENT | AWAITING_TRANSFER | PAID | PROCESSING | SHIPPED | DELIVERED | CANCELLED | EXPIRED
  paymentStatus        String    @default("UNPAID") // UNPAID | PAID | FAILED | REFUNDED | PARTIALLY_REFUNDED
  paymentMethod        String // CARD | BANK_TRANSFER
  paymentProvider      String?
  isTest               Boolean   @default(false)
  email                String
  phone                String
  customerName         String
  shipFullName         String
  shipPhone            String
  shipCity             String
  shipDistrict         String
  shipAddressLine      String
  shipPostalCode       String?
  billType             String // INDIVIDUAL | CORPORATE
  billFullName         String
  billCity             String
  billDistrict         String
  billAddressLine      String
  billCompanyName      String?
  billTaxOffice        String?
  billTaxNumber        String?
  customerNote         String?
  currency             String    @default("TRY")
  subtotalKurus        Int
  discountKurus        Int       @default(0)
  shippingKurus        Int       @default(0)
  vatKurus             Int
  totalKurus           Int
  couponId             String?
  couponCode           String?
  idempotencyKey       String    @unique
  reservedUntil        DateTime?
  stockReleasedAt      DateTime?
  shippingCarrier      String?
  trackingNumber       String?
  trackingUrl          String?
  adminNote            String?
  marketingConsent     Boolean   @default(false)
  agreementsAcceptedAt DateTime
  paidAt               DateTime?
  shippedAt            DateTime?
  deliveredAt          DateTime?
  cancelledAt          DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  user             User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  coupon           Coupon?            @relation(fields: [couponId], references: [id], onDelete: SetNull)
  items            OrderItem[]
  payments         Payment[]
  events           OrderStatusEvent[]
  agreements       OrderAgreement[]
  returnRequests   ReturnRequest[]
  couponRedemption CouponRedemption?

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([email])
  @@index([createdAt])
}

model OrderItem {
  id             String  @id @default(cuid())
  orderId        String
  productId      String?
  variantId      String?
  productName    String // sipariş anındaki ad (anlık görüntü)
  variantName    String
  sku            String
  imageUrl       String?
  packageType    String?
  unitPriceKurus Int
  vatRate        Int
  quantity       Int
  lineTotalKurus Int
  discountKurus  Int     @default(0)

  order       Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product?            @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant     ProductVariant?     @relation(fields: [variantId], references: [id], onDelete: SetNull)
  returnItems ReturnRequestItem[]

  @@index([orderId])
  @@index([productId])
}

model OrderStatusEvent {
  id                String   @id @default(cuid())
  orderId           String
  fromStatus        String?
  toStatus          String
  note              String?
  actorId           String?
  isCustomerVisible Boolean  @default(true)
  createdAt         DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
}

// Müşterinin onayladığı sözleşme metninin değiştirilemez kopyası
model OrderAgreement {
  id        String   @id @default(cuid())
  orderId   String
  kind      String // PRE_INFORMATION | DISTANCE_SALES
  title     String
  content   String
  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, kind])
}

model Payment {
  id                String    @id @default(cuid())
  orderId           String
  provider          String // paytr | iyzico | mock | bank_transfer
  mode              String // TEST | LIVE
  status            String // INITIATED | SUCCEEDED | FAILED | CANCELLED
  amountKurus       Int
  paidAmountKurus   Int?
  reference         String    @unique // sağlayıcıya gönderilen benzersiz referans
  providerToken     String?
  providerPaymentId String?
  failureCode       String?
  failureMessage    String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  completedAt       DateTime?

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([providerToken])
}

// Ödeme bildirimlerinin kaydı; aynı bildirimin ikinci kez işlenmesini engeller
model PaymentEvent {
  id        String   @id @default(cuid())
  provider  String
  eventKey  String
  paymentId String?
  verified  Boolean
  outcome   String // PROCESSED | DUPLICATE | REJECTED | IGNORED
  summary   String?
  createdAt DateTime @default(now())

  @@unique([provider, eventKey])
  @@index([createdAt])
}

model Coupon {
  id                 String    @id @default(cuid())
  code               String    @unique // büyük harfe normalize edilir
  description        String?
  type               String // PERCENT | FIXED | FREE_SHIPPING
  value              Int       @default(0) // PERCENT: yüzde, FIXED: kuruş
  minSubtotalKurus   Int?
  maxDiscountKurus   Int?
  startsAt           DateTime?
  endsAt             DateTime?
  usageLimit         Int?
  usageLimitPerEmail Int?
  usedCount          Int       @default(0)
  isActive           Boolean   @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  orders      Order[]
  redemptions CouponRedemption[]
}

model CouponRedemption {
  id        String   @id @default(cuid())
  couponId  String
  orderId   String   @unique
  email     String
  createdAt DateTime @default(now())

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([couponId, email])
}

model ReturnRequest {
  id                String   @id @default(cuid())
  referenceNo       String   @unique
  orderId           String
  userId            String?
  email             String
  reason            String // DAMAGED | WRONG_ITEM | MISSING_ITEM | QUALITY | OTHER
  details           String?
  status            String   @default("REQUESTED") // REQUESTED | APPROVED | REJECTED | RECEIVED | REFUNDED | CLOSED
  adminNote         String?
  refundAmountKurus Int?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  order Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user  User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  items ReturnRequestItem[]

  @@index([status, createdAt])
  @@index([orderId])
}

model ReturnRequestItem {
  id              String @id @default(cuid())
  returnRequestId String
  orderItemId     String
  quantity        Int

  returnRequest ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)
  orderItem     OrderItem     @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@index([returnRequestId])
}

// ---------------------------------------------------------------------------
// İçerik: blog / tarifler / sayfalar
// ---------------------------------------------------------------------------

model BlogCategory {
  id             String   @id @default(cuid())
  slug           String   @unique
  name           String
  description    String?
  sortOrder      Int      @default(0)
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  posts BlogPost[]
}

model BlogPost {
  id                String    @id @default(cuid())
  slug              String    @unique
  type              String    @default("ARTICLE") // ARTICLE | RECIPE | GUIDE
  title             String
  excerpt           String
  content           String // Markdown; ürün kartı için ayrı satırda [[urun:slug]]
  coverImageUrl     String?
  coverImageAlt     String?
  coverCredit       String?
  authorName        String
  status            String    @default("DRAFT") // DRAFT | PUBLISHED
  publishedAt       DateTime?
  readingMinutes    Int       @default(1)
  categoryId        String?
  seoTitle          String?
  seoDescription    String?
  recipeYield       String?
  prepMinutes       Int?
  cookMinutes       Int?
  recipeIngredients String? // satır başına bir malzeme
  recipeSteps       String? // satır başına bir adım
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  category BlogCategory?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  tags     BlogPostTag[]
  products BlogPostProduct[]

  @@index([status, publishedAt])
  @@index([categoryId])
}

model BlogTag {
  id    String        @id @default(cuid())
  slug  String        @unique
  name  String
  posts BlogPostTag[]
}

model BlogPostTag {
  postId String
  tagId  String

  post BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag  BlogTag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
  @@index([tagId])
}

model BlogPostProduct {
  postId    String
  productId String
  note      String?
  sortOrder Int     @default(0)

  post    BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  product Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([postId, productId])
  @@index([productId])
}

model Page {
  id             String    @id @default(cuid())
  slug           String    @unique
  title          String
  kind           String    @default("INFO") // INFO | LEGAL
  content        String // Markdown; {{SATICI_UNVAN}} gibi değişkenler site ayarlarından doldurulur
  status         String    @default("DRAFT") // DRAFT | PUBLISHED
  seoTitle       String?
  seoDescription String?
  publishedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model FaqItem {
  id          String   @id @default(cuid())
  question    String
  answer      String
  group       String?
  sortOrder   Int      @default(0)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Announcement {
  id        String    @id @default(cuid())
  message   String
  linkUrl   String?
  linkLabel String?
  startsAt  DateTime?
  endsAt    DateTime?
  isActive  Boolean   @default(true)
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

// ---------------------------------------------------------------------------
// B2B
// ---------------------------------------------------------------------------

model QuoteRequest {
  id            String   @id @default(cuid())
  referenceNo   String   @unique
  userId        String?
  companyName   String
  contactName   String
  email         String
  phone         String
  city          String?
  businessType  String?
  message       String?
  status        String   @default("NEW") // NEW | IN_REVIEW | QUOTED | WON | LOST | CLOSED
  kvkkConsentAt DateTime
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user  User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  items QuoteRequestItem[]
  notes QuoteNote[]

  @@index([status, createdAt])
}

model QuoteRequestItem {
  id             String  @id @default(cuid())
  quoteRequestId String
  variantId      String?
  productName    String
  variantName    String?
  quantity       Int
  unit           String // ADET | KOLI | KOVA | PAKET | KG
  note           String?

  quoteRequest QuoteRequest    @relation(fields: [quoteRequestId], references: [id], onDelete: Cascade)
  variant      ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([quoteRequestId])
}

model QuoteNote {
  id             String   @id @default(cuid())
  quoteRequestId String
  kind           String // NOTE | EMAIL_SENT | STATUS_CHANGE
  body           String
  actorId        String?
  createdAt      DateTime @default(now())

  quoteRequest QuoteRequest @relation(fields: [quoteRequestId], references: [id], onDelete: Cascade)

  @@index([quoteRequestId, createdAt])
}

// İleride B2B müşterilere özel fiyat ve minimum miktar tanımları için
model PriceList {
  id          String   @id @default(cuid())
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  entries PriceListEntry[]
  users   User[]
}

model PriceListEntry {
  id          String @id @default(cuid())
  priceListId String
  variantId   String
  priceKurus  Int
  minQty      Int    @default(1)

  priceList PriceList      @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([priceListId, variantId, minQty])
  @@index([variantId])
}

// ---------------------------------------------------------------------------
// Site ayarları, iletişim, bülten, medya, güvenlik kayıtları
// ---------------------------------------------------------------------------

model SiteSettings {
  id                         Int      @id @default(1)
  storeName                  String   @default("ByMaster")
  companyLegalName           String?
  companyAddress             String?
  companyPhone               String?
  companyEmail               String?
  companyMersis              String?
  companyTaxOffice           String?
  companyTaxNumber           String?
  companyKep                 String?
  etbisUrl                   String?
  supportHours               String?
  instagramUrl               String?
  whatsappPhone              String?
  orderNotificationEmail     String?
  shippingFeeKurus           Int? // null = kargo ücreti yapılandırılmadı (sipariş alınmaz)
  freeShippingThresholdKurus Int?
  shippingVatRate            Int      @default(20)
  shippingCarrierName        String?
  dispatchTimeText           String?
  bankTransferEnabled        Boolean  @default(false)
  bankAccountsJson           String? // [{ "bankName", "accountHolder", "iban" }]
  bankTransferHoldHours      Int      @default(48)
  paymentReservationMinutes  Int      @default(30)
  gaMeasurementId            String?
  metaPixelId                String?
  updatedAt                  DateTime @updatedAt
}

model NewsletterSubscription {
  id               String    @id @default(cuid())
  email            String    @unique
  status           String    @default("ACTIVE") // ACTIVE | UNSUBSCRIBED
  consentText      String
  source           String?
  unsubscribeToken String    @unique
  createdAt        DateTime  @default(now())
  unsubscribedAt   DateTime?
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String
  message   String
  status    String   @default("NEW") // NEW | READ | ARCHIVED
  createdAt DateTime @default(now())

  @@index([status, createdAt])
}

model MediaAsset {
  id           String   @id @default(cuid())
  storageKey   String   @unique
  url          String
  originalName String
  mimeType     String
  sizeBytes    Int
  width        Int
  height       Int
  alt          String?
  uploadedById String?
  createdAt    DateTime @default(now())
}

model RateLimit {
  key         String   @id
  count       Int
  windowStart DateTime

  @@index([windowStart])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String?
  summary    String?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([entityType, entityId])
}

model EmailLog {
  id        String   @id @default(cuid())
  to        String
  subject   String
  template  String
  status    String // SENT | FAILED | SKIPPED
  error     String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}
